# Copiá a .env.local y completá cuando las placas estén conectadas al Wi-Fi.
# Lista de placas: Nombre=IP, separadas por comas. Usá IPs privadas reservadas
# en el router o nombres locales terminados en .local.
ESP32_DEVICES=Consola=192.168.1.50,Holo=192.168.1.51

# Generá un token aleatorio largo; es el mismo API_TOKEN de wifi_secrets.py
# en todas las placas. No lo pongas en variables NEXT_PUBLIC_ ni lo subas a Git.
ESP32_API_TOKEN=replace-with-a-long-random-secret
