# Copiá a .env.local y completá cuando el ESP32 esté conectado al Wi-Fi.
# Usá una IP privada reservada en el router o un nombre local terminado en .local.
ESP32_BASE_URL=http://192.168.1.50

# Generá un token aleatorio largo; usaremos el mismo en el firmware del ESP32.
# No lo pongas en variables NEXT_PUBLIC_ ni lo subas a Git.
ESP32_API_TOKEN=replace-with-a-long-random-secret
